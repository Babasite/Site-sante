# Développement local
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-only-if-needed-locally
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Production (exemples)
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DATABASE_URL=postgresql://user:password@host:5432/database
# DJANGO_SECURE_SSL_REDIRECT=True

# Formulaire de contact
# En production, décommentez et renseignez ces valeurs dans votre vrai fichier .env.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_HOST_USER=votre-adresse@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=mot-de-passe-application-google
# DJANGO_DEFAULT_FROM_EMAIL=votre-adresse@gmail.com
# DJANGO_CONTACT_EMAIL=votre-adresse@gmail.com

# Heure locale de lancement automatique de la veille (0-23)
VEILLE_HEURE_AUTO=7
